# === LaunchRoast environment ===

# Anthropic — powers the roast engine and the CEO agent
ANTHROPIC_API_KEY=sk-ant-...

# Whop — payments. Create a business at https://dash.whop.com
# API key: dash.whop.com -> Developer -> API keys
WHOP_API_KEY=
# Your product's checkout link (shown on the landing page buy button)
NEXT_PUBLIC_WHOP_CHECKOUT_URL=https://whop.com/checkout/plan_XXXX
# Webhook secret from dash.whop.com -> Developer -> Webhooks (endpoint: /api/webhook)
WHOP_WEBHOOK_SECRET=

# Terac — human-in-the-loop (redeem credits via guidebook link; install the
# Terac MCP in Claude Code to launch studies). REST adapter vars optional:
TERAC_API_URL=
TERAC_API_KEY=

# Exa — competitive-landscape search inside the roast (code EXA50ZEROHUMAN)
EXA_API_KEY=

# Comma-separated demo codes that bypass payment (for judges / demo video)
DEMO_CODES=ROAST-JUDGE-2026

# Public URL of the deployed app (used in agent-generated marketing)
NEXT_PUBLIC_APP_URL=https://launchroast.vercel.app
